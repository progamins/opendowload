# Desarrollo local: backend en tu PC
VITE_API_URL=http://127.0.0.1:3001/api

# Producción Vercel + Cloudflare Tunnel (ejemplo, reemplaza xxxxx):
# VITE_API_URL=https://xxxxx.trycloudflare.com/api

# También puedes dejar VITE_API_URL vacío y configurar runtime vía public/config.json:
# { "apiUrl": "https://xxxxx.trycloudflare.com/api" }
# VITE_API_URL es build-time (requiere rebuild si cambia la URL del túnel).
# public/config.json es runtime (no requiere rebuild, solo redeploy del json).
