PORT=3001
HOST=127.0.0.1
# Directorios (relativos a server/)
DOWNLOAD_DIR=../downloads
TEMP_DIR=../temp
LOG_DIR=../logs
DATABASE_PATH=../data/app.db
# Concurrencia (fijo 2 para producción, no subir)
MAX_CONCURRENT_DOWNLOADS=2
# Binarios
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# CORS: lista separada por comas de orígenes permitidos
# Desarrollo: http://127.0.0.1:5173,http://localhost:5173
# Producción Vercel: añade https://tu-app.vercel.app
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Auth ligera opcional (si está vacío, no se exige token)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=
# Si usas Cloudflare Access, pon aquí el team domain (opcional)
# CLOUDFLARE_ACCESS_TEAM=
