# OpenMedia Downloader - Server Environment Variables
# Copy this file to .env and customize as needed.
# All values have safe defaults if omitted.

# Server bind address (127.0.0.1 = local only, 0.0.0.0 = all interfaces)
HOST=127.0.0.1

# Server port
PORT=3001

# Directories (relative to server/ or absolute)
# DOWNLOAD_DIR=../downloads
# TEMP_DIR=../temp
# LOG_DIR=../logs
# DATABASE_PATH=../data/app.db

# External tools
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg

# CORS: comma-separated list of allowed origins (leave empty for defaults)
# ALLOWED_ORIGINS=https://opendowload.vercel.app

# API key: si se define, TODAS las mutaciones (POST/DELETE) exigen el header
# X-API-Key (o Authorization: Bearer). Los GET de estado y health quedan abiertos.
# Déjala vacía solo para uso 100% local. Con el túnel público, DEBES definirla.
# API_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
